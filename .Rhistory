library(singleRcapture)
library(data.table)
snakes <- data.frame(captures = 1:5,
freq = c(59, 8, 1, 1, 1))
violence <- data.frame(captures = 1:6,
freq = c(15169, 1957, 393, 99, 28, 16))
netherlands <- data.frame(captures = 1:6,
freq = c(1645, 183, 37, 13, 1, 1))
models <- c("ztgeom", "oiztgeom", "ztoigeom",
"ztpoisson", "oiztpoisson", "ztoipoisson")
## run all models for the Snakes example
snakes_results <- lapply(models, \(x) {
res <- estimatePopsize(formula = captures ~ 1,
data = snakes,
weights = snakes$freq,
model = x,
controlModel = controlModel(weightsAsCounts = T))
return(
data.frame(N_hat = res$populationSize$pointEstimate,
N_hat_l = res$populationSize$confidenceInterval[2, 1],
N_hat_u = res$populationSize$confidenceInterval[2, 2],
AIC = AIC(res),
BIC = BIC(res))
)
})
names(snakes_results) <- models
snakes_results_df <- rbindlist(snakes_results, idcol = "model")
## run all models for the Violence example
violence_results <- lapply(models, \(x) {
res <- estimatePopsize(formula = captures ~ 1,
data = violence,
weights = violence$freq,
model = x,
controlModel = controlModel(weightsAsCounts = T))
return(
data.frame(N_hat = res$populationSize$pointEstimate,
N_hat_l = res$populationSize$confidenceInterval[2, 1],
N_hat_u = res$populationSize$confidenceInterval[2, 2],
AIC = AIC(res),
BIC = BIC(res))
)
})
names(violence_results) <- models
violence_results_df <- rbindlist(violence_results, idcol = "model")
## run all models for the Violence example
netherlands_results <- lapply(models, \(x) {
res <- estimatePopsize(formula = captures ~ 1,
data = netherlands,
weights = netherlands$freq,
model = x,
controlModel = controlModel(weightsAsCounts = T))
return(
data.frame(N_hat = res$populationSize$pointEstimate,
N_hat_l = res$populationSize$confidenceInterval[2, 1],
N_hat_u = res$populationSize$confidenceInterval[2, 2],
AIC = AIC(res),
BIC = BIC(res))
)
})
names(netherlands_results) <- models
netherlands_results_df <- rbindlist(netherlands_results, idcol = "model")
netherlands_results_df
snakes_results_df
netherlands_results_df
